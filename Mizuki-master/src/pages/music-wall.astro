---
// 直接使用 Mizuki 的全局路径别名引入核心布局
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

if (!siteConfig.featurePages.musicWall) {
	return Astro.redirect("/404/");
}
---

<MainGridLayout
	title={i18n(I18nKey.musicWall)}
	description={i18n(I18nKey.musicWallSubtitle)}
>
	<div class="music-wall-container">
		<iframe
			src="/music-wall/index.html"
			frameborder="0"
			allow="autoplay; fullscreen"></iframe>
	</div>
</MainGridLayout>

<style>
	.music-wall-container {
		width: 100%;
		/* 配合 MainGridLayout 的上下边距，高度稍微缩小一点防止页面出现双滚动条 */
		height: calc(100vh - 120px);
		border-radius: 12px;
		overflow: hidden;
		position: relative;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
		border: 1px solid var(--card-border-color, rgba(255, 255, 255, 0.1)); /* 兼容主题的边框颜色 */
	}

	iframe {
		width: 100%;
		height: 100%;
		display: block;
		background: #000;
	}
</style>
